# Copy this file to .env and fill in real values (and add the same three to
# Vercel: Project Settings -> Environment Variables).
# Until they're set, the blog runs on built-in sample posts and changes made
# in the admin are only kept until the server restarts.

# Neon Postgres connection string (Vercel dashboard -> Storage -> Neon).
# After setting it, run `npm run db:seed` once to create the blog table.
POSTGRES_URL=

# Password for the blog admin at /admin
BLOG_ADMIN_PASSWORD=

# Vercel Blob token, for photo uploads on blog posts
# (Vercel dashboard -> Storage -> Blob -> create a store -> copy token)
BLOB_READ_WRITE_TOKEN=
