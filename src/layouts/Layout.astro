---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  // Nav floats transparently over a full-bleed hero (the homepage video).
  overlayNav?: boolean;
}

const {
  title,
  description = "Cinematic wedding, promo and event videography for San Diego couples and small businesses.",
  image = "/opengraph.jpg",
  noindex = false,
  overlayNav = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const imageURL = new URL(image, Astro.site).toString();
const fullTitle = title === "Home" ? "Heyl Productions | San Diego Videography" : `${title} | Heyl Productions`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={fullTitle}
      description={description}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: fullTitle,
          image: imageURL,
        },
      }}
    />
  </head>
  <body>
    <Navbar overlay={overlayNav} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
