---
import Container from "@components/container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

export interface Props {
  // Transparent, light-text nav laid over a full-bleed hero (homepage video).
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const menuitems = [
  { title: "Services", path: "/service" },
  { title: "Portfolio", path: "/portfolio" },
  { title: "Blog", path: "/blog" },
  { title: "About", path: "/about" },
];

const current = Astro.url.pathname;
const isActive = (path: string) => current === path || current.startsWith(`${path}/`);
---

<div class:list={[overlay && "absolute inset-x-0 top-0 z-20 text-paper"]}>
  <Container>
    <header class="flex flex-col lg:flex-row justify-between lg:items-center py-6 gap-4">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a href="/" class="font-serif text-3xl leading-none">Heyl <span class="italic">Productions</span></a>
          <div class="block lg:hidden">
            <MenuIcon class={overlay ? "w-6 h-6 text-paper" : "w-6 h-6 text-ink"} />
          </div>
        </div>
        <MenuItems
          class:list={[
            "hidden w-full lg:w-auto lg:flex",
            // Over the video, give the opened mobile menu its own dark panel.
            overlay && "bg-ink/85 rounded-2xl px-5 pb-5 mt-3 lg:bg-transparent lg:p-0 lg:mt-0",
          ]}>
          <ul class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-8 mt-4 lg:mt-0 text-[13px] font-semibold uppercase tracking-[0.12em]">
            {
              menuitems.map((item) => (
                <li>
                  <a
                    href={item.path}
                    class:list={[
                      "block py-2 transition-colors",
                      overlay ? "hover:text-pine-mist" : "hover:text-pine",
                      isActive(item.path) && !overlay && "text-pine",
                    ]}
                    aria-current={isActive(item.path) ? "page" : undefined}>
                    {item.title}
                  </a>
                </li>
              ))
            }
            <li class="mt-2 lg:mt-0">
              <a href="/contact" class:list={[overlay ? "btn-light" : "btn-primary", "px-6 py-3"]}>Inquire</a>
            </li>
          </ul>
        </MenuItems>
      </Astronav>
    </header>
  </Container>
</div>
