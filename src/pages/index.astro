---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import ServiceCards from "@components/ServiceCards.astro";
import VideoEmbed from "@components/VideoEmbed.astro";
import BlogCard from "@components/BlogCard.astro";
import VideoHero from "@components/VideoHero.astro";
import { get_recent_posts, type BlogPost } from "@models/blog_posts";
import erickSammie from "@assets/photos/erick-sammie.jpg";
import onSet from "@assets/photos/on-set.jpg";

// Rendered per request so new blog posts show up without a redeploy.
export const prerender = false;

const clients = ["Yelp", "Comfort & Peace", "Dirty Dough", "Pretty Petals SD", "Hop Stop"];

const reels = [
  { id: "SaZ7Rjn9Y18", title: "Air & Space Halloween" },
  { id: "OPnxxHnJIcE", title: "Rancho Guejito" },
  { id: "S4ryQhjM-vg", title: "The Flower Fields, Carlsbad" },
];

let posts: BlogPost[] = [];
try {
  posts = await get_recent_posts(3);
} catch (err) {
  console.error("Failed to load recent blog posts for the homepage:", err);
}
---

<Layout title="Home" overlayNav>
  <VideoHero />

  <!-- The rest of the page is a sheet that slides up over the pinned video -->
  <div class="relative z-10 -mt-10 overflow-hidden rounded-t-[32px] bg-paper shadow-[0_-12px_40px_rgba(28,26,23,0.18)]">
  <!-- Trusted by -->
  <section class="border-b border-line pt-2">
    <Container>
      <p class="flex flex-wrap justify-center gap-x-11 gap-y-3 py-6 text-[13px] font-semibold uppercase tracking-[0.16em] text-muted">
        <span class="text-pine">Trusted by</span>
        {clients.map((client) => <span>{client}</span>)}
      </p>
    </Container>
  </section>

  <!-- Services -->
  <Container>
    <section class="py-28">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="eyebrow mb-4">What we offer</p>
        <h2 class="text-5xl md:text-6xl leading-none mb-5">Four ways to tell your <span class="italic">story</span></h2>
        <p class="text-lg leading-relaxed text-muted">
          Professional video, lighting and sound, a fair and transparent quote before any work begins, and delivery in about two weeks.
        </p>
      </div>
      <ServiceCards />
    </section>
  </Container>

  <!-- About + testimonial -->
  <section class="bg-sand">
    <Container>
      <div class="flex flex-col lg:flex-row items-center gap-16 py-28">
        <div class="flex-1 grid grid-cols-2 gap-5 items-end w-full">
          <Image
            src={erickSammie}
            alt="Erick and Sammie Heyl"
            widths={[320, 640]}
            sizes="(min-width: 1024px) 300px, 45vw"
            class="w-full aspect-[3/4.2] object-cover object-[62%_40%] rounded-xl"
          />
          <Image
            src={onSet}
            alt="Erick filming a dessert table while Sammie holds a light"
            widths={[320, 640]}
            sizes="(min-width: 1024px) 300px, 45vw"
            class="w-full aspect-[3/3.4] object-cover rounded-xl"
          />
        </div>
        <div class="flex-1">
          <blockquote class="font-serif text-4xl md:text-5xl leading-tight">
            “That's the most beautiful video I've ever seen in my life. <span class="italic text-pine">I'm crying like a baby.</span>”
          </blockquote>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted mt-6 mb-10">Dom &amp; Nicole · Wedding</p>
          <p class="text-lg leading-relaxed text-muted mb-6">
            We're a small team with a personal touch. We'll get to know you, show up early, stay out of the way, and make sure you enjoy the process as much as we do.
          </p>
          <a href="/about" class="text-link">Meet Erick &amp; Sammie</a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Reels -->
  <Container>
    <section class="py-28">
      <div class="text-center mb-14">
        <p class="eyebrow mb-4">Selected work</p>
        <h2 class="text-5xl md:text-6xl leading-none">Yelp San Diego's <span class="italic">preferred</span> videographer</h2>
      </div>
      <div class="grid gap-8 md:grid-cols-3 max-w-5xl mx-auto">
        {reels.map((reel) => <VideoEmbed id={reel.id} title={reel.title} vertical />)}
      </div>
      <div class="text-center mt-12">
        <a href="/portfolio" class="btn-outline">Full portfolio</a>
      </div>
    </section>
  </Container>

  <!-- Blog -->
  {
    posts.length > 0 && (
      <section class="border-t border-line">
        <Container>
          <div class="py-28">
            <div class="flex flex-wrap justify-between items-end gap-6 mb-12">
              <h2 class="text-5xl md:text-6xl leading-none">
                The <span class="italic">Journal</span>
              </h2>
              <a href="/blog" class="text-link">Read the blog</a>
            </div>
            <div class="grid gap-8 md:grid-cols-3">
              {posts.map((post) => <BlogCard post={post} />)}
            </div>
          </div>
        </Container>
      </section>
    )
  }

  <!-- CTA -->
  <section class="bg-pine text-paper">
    <Container>
      <div class="max-w-3xl mx-auto py-28 text-center">
        <h2 class="text-5xl md:text-7xl leading-none mb-6">Tell us about <span class="italic">your</span> vision.</h2>
        <p class="text-lg leading-relaxed text-pine-mist max-w-xl mx-auto mb-10">
          A short call, a fair and transparent quote, and a film you'll keep for years.
        </p>
        <a href="/contact" class="btn-light">Start your inquiry</a>
      </div>
    </Container>
  </section>
  </div>
</Layout>
