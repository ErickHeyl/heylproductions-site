---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import BlogPostForm from "@components/BlogPostForm.astro";
import { isAuthenticated } from "@lib/adminAuth";

export const prerender = false;

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect("/admin/login");
}
---

<Layout title="Write a Blog Post" noindex>
  <Container>
    <div class="py-20 max-w-2xl mx-auto">
      <div class="flex items-start justify-between gap-4 mb-12">
        <div>
          <h1 class="text-5xl mb-3">Write a blog post</h1>
          <p class="text-muted">It appears on the <a href="/blog" class="text-link">blog</a> as soon as you publish. No code or redeploy needed.</p>
        </div>
        <a href="/admin" class="text-sm font-semibold uppercase tracking-[0.14em] text-muted hover:text-ink whitespace-nowrap mt-3">&larr; Admin</a>
      </div>

      <BlogPostForm submitUrl="/api/blog/create" submitLabel="Publish post" />
    </div>
  </Container>
</Layout>
