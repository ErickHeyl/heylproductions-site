---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { isAuthenticated } from "@lib/adminAuth";
import { get_all_posts, CATEGORY_LABEL, type BlogPost } from "@models/blog_posts";

export const prerender = false;

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect("/admin/login");
}

let posts: BlogPost[] = [];
let loadError = false;
try {
  posts = await get_all_posts();
} catch (err) {
  console.error("Failed to load posts for the admin list:", err);
  loadError = true;
}
---

<Layout title="Manage Posts" noindex>
  <Container>
    <div class="py-20 max-w-2xl mx-auto">
      <div class="flex items-start justify-between gap-4 mb-12">
        <div>
          <h1 class="text-5xl mb-3">Manage posts</h1>
          <p class="text-muted">Click a post to edit it.</p>
        </div>
        <a href="/admin" class="text-sm font-semibold uppercase tracking-[0.14em] text-muted hover:text-ink whitespace-nowrap mt-3">&larr; Admin</a>
      </div>

      {loadError && <p class="text-red-700">Couldn't load posts right now. Please try again in a moment.</p>}

      {
        !loadError && posts.length === 0 && (
          <p class="text-muted">
            No posts yet. <a href="/admin/blog/new" class="text-link">Write one</a>.
          </p>
        )
      }

      <div class="flex flex-col gap-3">
        {
          posts.map((post) => (
            <a href={`/admin/blog/${post.slug}/edit`} class="block bg-white border border-line rounded-xl p-6 hover:border-pine transition">
              <p class="eyebrow mb-1">
                {CATEGORY_LABEL[post.category]} · {post.date_label}
              </p>
              <p class="font-serif text-2xl">{post.title}</p>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
