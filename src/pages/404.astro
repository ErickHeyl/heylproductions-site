---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
---

<Layout title="Page not found" noindex>
  <Container>
    <div class="min-h-[60vh] flex flex-col items-center justify-center text-center gap-6 py-24">
      <p class="eyebrow">404</p>
      <h1 class="text-6xl md:text-7xl leading-none">This scene was <span class="italic text-pine">cut.</span></h1>
      <p class="text-lg text-muted">We couldn't find the page you were looking for.</p>
      <a href="/" class="btn-primary">Back to home</a>
    </div>
  </Container>
</Layout>
