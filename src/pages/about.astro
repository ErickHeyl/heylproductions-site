---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import erickSammie from "@assets/photos/erick-sammie.jpg";
import yelpEvent from "@assets/photos/yelp-event.jpg";
import onSet from "@assets/photos/on-set.jpg";

const testimonials = [
  {
    quote:
      "Erick and Sam were absolutely amazing to work with! From start to finish, they made the entire process so easy and enjoyable. The videos turned out beautifully, far beyond my expectations, and perfectly captured the heart of the event. Throughout the day, they were incredibly professional, attentive, and helpful, making sure every moment was documented in the best way possible.",
    who: "Tatiana & Johnny · Wedding",
  },
  {
    quote:
      "Okay, I couldn't wait. That's the most beautiful video I've ever seen in my life. I'm crying like a baby. Words cannot express how thankful I am. We are obsessed and we are all crying like babies over here!",
    who: "Dom & Nicole · Wedding",
  },
];
---

<Layout title="About" description="Heyl Productions is Erick and Sammie Heyl, a husband-and-wife video team from San Diego.">
  <Container>
    <section class="flex flex-col lg:flex-row items-center gap-16 pt-12 pb-28">
      <div class="flex-1">
        <p class="eyebrow mb-5">About us</p>
        <h1 class="text-6xl md:text-7xl leading-none mb-8">Capturing San Diego on film <span class="italic text-pine">since 2019</span></h1>
        <p class="text-lg leading-relaxed text-muted mb-5">
          Heyl Productions is Erick and Sammie Heyl. We're a husband-and-wife video production team proud to serve the community we've known all our lives.
        </p>
        <p class="text-lg leading-relaxed text-muted">
          Cinematic wedding videography is how we got our start. Our passion is capturing the emotion, beauty, and story of your day so you can relive those moments for years to come, from intimate elopements to grand celebrations.
        </p>
      </div>
      <div class="flex-1 w-full">
        <Image
          src={erickSammie}
          alt="Erick and Sammie Heyl"
          widths={[480, 960]}
          sizes="(min-width: 1024px) 560px, 100vw"
          loading="eager"
          class="w-full aspect-[4/3.4] object-cover object-[62%_40%] rounded-xl"
        />
      </div>
    </section>
  </Container>

  <section class="bg-sand">
    <Container>
      <div class="grid lg:grid-cols-2 gap-16 py-28 items-center">
        <div class="grid grid-cols-2 gap-5 items-end">
          <Image src={yelpEvent} alt="Erick and Sammie at a Yelp event" widths={[320, 567]} sizes="(min-width: 1024px) 300px, 45vw" class="w-full aspect-[3/4.4] object-cover object-top rounded-xl" />
          <Image src={onSet} alt="Erick filming while Sammie holds a light" widths={[320, 640]} sizes="(min-width: 1024px) 300px, 45vw" class="w-full aspect-[3/3.4] object-cover rounded-xl" />
        </div>
        <div>
          <h2 class="text-5xl leading-none mb-8">Born and raised <span class="italic">San Diegans</span></h2>
          <p class="text-lg leading-relaxed text-muted mb-5">
            Erick fell in love with videography several years ago, and quickly realized he could use it to support our growing family while providing valuable services to the community we call home.
          </p>
          <p class="text-lg leading-relaxed text-muted">
            Since then we've served a rapidly growing number of San Diego couples and businesses, from weddings across Southern California to local shops like Hop Stop, Pretty Petals, and Dirty Dough, and large corporate events like Yelp's.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <section class="grid md:grid-cols-2 gap-16 py-28 max-w-6xl mx-auto">
      <div>
        <p class="eyebrow mb-4">What sets us apart</p>
        <h2 class="text-4xl leading-tight mb-6">A personal touch</h2>
        <p class="text-lg leading-relaxed text-muted mb-5">
          As a small team, we know we have to go above and beyond to compete with large production companies with dozens of staff.
        </p>
        <p class="text-lg leading-relaxed text-muted">
          Our advantage is our personal touch. We know and love the area, and we're personally invested in seeing the community and its local businesses grow stronger.
        </p>
      </div>
      <div>
        <p class="eyebrow mb-4">How we work</p>
        <h2 class="text-4xl leading-tight mb-6">A friendly face behind the camera</h2>
        <p class="text-lg leading-relaxed text-muted mb-5">
          We'll get the job done on time and within budget. Just as important, we want you to enjoy the process as much as we do.
        </p>
        <p class="text-lg leading-relaxed text-muted">
          We'll get to know you, your business, and your people, and use everything at our disposal to produce a video that helps your dream keep thriving.
        </p>
      </div>
    </section>
  </Container>

  <section class="border-t border-line">
    <Container>
      <div class="py-28 max-w-4xl mx-auto text-center">
        <p class="eyebrow mb-12">Kind words</p>
        <div class="flex flex-col gap-16">
          {
            testimonials.map((t) => (
              <figure>
                <blockquote class="font-serif text-3xl md:text-4xl leading-snug">“{t.quote}”</blockquote>
                <figcaption class="text-xs font-semibold uppercase tracking-[0.24em] text-muted mt-6">{t.who}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-pine text-paper">
    <Container>
      <div class="max-w-3xl mx-auto py-28 text-center">
        <h2 class="text-5xl md:text-6xl leading-none mb-6">Looking for a videographer who cares as much as <span class="italic">you do?</span></h2>
        <p class="text-lg text-pine-mist mb-10">Fill out our contact form and let's start turning your vision into reality.</p>
        <a href="/contact" class="btn-light">Let's talk</a>
      </div>
    </Container>
  </section>
</Layout>
