---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import VideoEmbed from "@components/VideoEmbed.astro";

interface Video {
  id: string;
  title: string;
}

interface Section {
  eyebrow: string;
  title: string;
  featured?: Video;
  videos: Video[];
  vertical: boolean;
}

const sections: Section[] = [
  {
    eyebrow: "Weddings",
    title: "Wedding films",
    featured: { id: "fy1jPwLMvgY", title: "Tatiana & Johnny" },
    videos: [
      { id: "YURWqTH_Qjw", title: "Dom & Nicole" },
      { id: "D3hYzdkPRfo", title: "Claire & Taylor" },
      { id: "ILGs6kNYPSs", title: "Debbie & Curtis" },
    ],
    vertical: false,
  },
  {
    eyebrow: "Yelp San Diego",
    title: "Vertical reels for Yelp",
    videos: [
      { id: "S4ryQhjM-vg", title: "The Flower Fields" },
      { id: "OPnxxHnJIcE", title: "Rancho Guejito" },
      { id: "hGjnzrHYPKI", title: "Toasted Gastropub + Dinner" },
      { id: "SaZ7Rjn9Y18", title: "Halloween Event" },
      { id: "uzmutiXiA54", title: "Rooftop Cinema Club" },
      { id: "Ejiuovk-S3o", title: "Piper" },
    ],
    vertical: true,
  },
  {
    eyebrow: "Business",
    title: "Business promo videos",
    featured: { id: "apkDlvlwsNk", title: "Comfort & Peace Company Celebration" },
    videos: [
      { id: "xLpli9My15w", title: "Pretty Petals SD" },
      { id: "vbdF2oStSxA", title: "Dirty Dough" },
      { id: "b36Eq_4GItc", title: "The Lookout at Lake Poway" },
    ],
    vertical: true,
  },
  {
    eyebrow: "Family",
    title: "Family video shoots",
    videos: [
      { id: "losVklkTizw", title: "Cori Baby Shower" },
      { id: "V3AnMvpFcTQ", title: "Sarah Baby Shower" },
      { id: "LXpj0xoyqsk", title: "Trish & Andrew Maternity" },
    ],
    vertical: true,
  },
];
---

<Layout title="Portfolio" description="Wedding films, Yelp reels, business promos and family shoots by Heyl Productions.">
  <Container>
    <header class="text-center max-w-3xl mx-auto pt-12 pb-20">
      <p class="eyebrow mb-5">Portfolio</p>
      <h1 class="text-6xl md:text-7xl leading-none mb-6">Our <span class="italic text-pine">films</span></h1>
      <p class="text-lg leading-relaxed text-muted">A selection of our video work, organized by category.</p>
    </header>
  </Container>

  {
    sections.map((section, i) => (
      <section class:list={[i % 2 === 1 ? "bg-sand" : "border-t border-line"]}>
        <Container>
          <div class="py-24 max-w-5xl mx-auto">
            <div class="text-center mb-14">
              <p class="eyebrow mb-4">{section.eyebrow}</p>
              <h2 class="text-5xl leading-none">{section.title}</h2>
            </div>
            {section.featured && (
              <VideoEmbed id={section.featured.id} title={section.featured.title} class="mb-14" />
            )}
            <div class:list={["grid gap-8 md:grid-cols-3", section.vertical && "max-w-4xl mx-auto"]}>
              {section.videos.map((video) => (
                <VideoEmbed id={video.id} title={video.title} vertical={section.vertical} />
              ))}
            </div>
          </div>
        </Container>
      </section>
    ))
  }

  <section class="bg-pine text-paper">
    <Container>
      <div class="max-w-3xl mx-auto py-24 text-center">
        <h2 class="text-5xl md:text-6xl leading-none mb-8">Like what you <span class="italic">see?</span></h2>
        <a href="/contact" class="btn-light">Start your inquiry</a>
      </div>
    </Container>
  </section>
</Layout>
