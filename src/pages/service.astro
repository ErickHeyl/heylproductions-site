---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { get_posts_by_category, type BlogCategory, type BlogPost } from "@models/blog_posts";
import { BLOG_ENABLED } from "@data/features";

// Rendered per request so each service's related blog posts stay current.
export const prerender = false;

interface Service {
  id: string;
  numeral: string;
  title: string;
  lead: string;
  includes?: string[];
  details: string[];
  cta: string;
  category?: BlogCategory;
}

const services: Service[] = [
  {
    id: "weddings",
    numeral: "i.",
    title: "Wedding films",
    lead: "Preserve the memories of your special day with a beautifully crafted wedding video.",
    includes: ["Ceremony & reception coverage", "Editing", "Highlight reel"],
    details: [
      "We'll capture the important moments, from the ceremony to the celebration, using professional video, lighting, and sound equipment. After filming, we'll create a highlight video and can provide full-length edits upon request.",
      "We'll work with you to understand your vision and deliver a video you'll cherish for years to come. Transparent pricing and flexible packages are available.",
    ],
    cta: "Inquire about weddings",
    category: "weddings",
  },
  {
    id: "business",
    numeral: "ii.",
    title: "Business promo videos",
    lead: "Increase the visibility of your marketing and make your products stand out on social media with high-quality, cinematic promotional videos that won't break your budget.",
    includes: ["Filming", "Editing", "Custom scope"],
    details: [
      "Schedule a time and place. We'll come with the video, lighting, and sound equipment to capture your vision. We'll take the raw footage and create at least one Instagram-ready 60-second video, usually within 2 weeks.",
      "Want multiple shoots? More videos? We've got you covered: as many clips, full promos, or branded story videos as you need. Once we know the time, place, and deliverables, we'll give you a fair and transparent quote before any work begins.",
    ],
    cta: "Reach out",
    category: "business",
  },
  {
    id: "events",
    numeral: "iii.",
    title: "Event coverage & recap videos",
    lead: "Capture the magic and atmosphere of your upcoming event, product launch, fundraiser, team party, or community benefit.",
    includes: ["Event coverage", "Editing", "Hassle-free service"],
    details: [
      "We'll show up early, figure out lighting and sound, and start planning shots while you get the party started. We'll take the raw footage and create at least one Instagram-ready 60-second video, usually within 2 weeks. Want more videos? Full-length coverage? Just ask!",
      "Hosting an event is stressful enough without needing to put out fires from a confused or invasive video crew. We'll handle business discreetly so you can enjoy the event. We charge a fair hourly rate for coverage and customize pricing based on how many videos you want edited.",
    ],
    cta: "Get a quote now",
    category: "events",
  },
  {
    id: "custom",
    numeral: "iv.",
    title: "Custom video solutions",
    lead: "Aside from our turnkey promo and event services, we're also happy to take on unique or custom projects of any kind.",
    details: [
      "Training videos? Testimonials? Internal communications? We're eager to work out your vision with you and deliver a product you're satisfied with. Fill out our intake form and give us an idea of what you've got in mind, and we'll work out the details.",
    ],
    cta: "Get started now",
  },
];

const processSteps = [
  {
    title: "Initial consultation",
    detail: "Fill out our intake form and we'll give you a call back. Over 20 to 30 minutes we'll learn about your project, deliverables, location, and timing, then put together a fair and transparent quote.",
  },
  {
    title: "Pre-production",
    detail: "If you're happy with the quote, we begin planning, including story and direction for more complex projects.",
  },
  {
    title: "Filming",
    detail: "We arrive early and film on industry-leading Sony cameras. The goal is simple: cinema-quality footage while staying out of the way. If we do our job well, you'll forget we're even there.",
  },
  {
    title: "Editing & delivery",
    detail: "We start editing right away and usually deliver within about 2 weeks (need it faster? Let us know). Every video is full-HD or 4K with professional sound, in 9:16 vertical, 16:9 wide-screen, or a custom format.",
  },
];

const related: Partial<Record<BlogCategory, BlogPost[]>> = {};
try {
  for (const category of BLOG_ENABLED ? (["weddings", "business", "events"] as BlogCategory[]) : []) {
    related[category] = await get_posts_by_category(category, 2);
  }
} catch (err) {
  console.error("Failed to load related blog posts for the services page:", err);
}
---

<Layout
  title="Services"
  description="Wedding films, business promo videos, event coverage and custom video projects across San Diego.">
  <Container>
    <header class="text-center max-w-3xl mx-auto pt-12 pb-20">
      <p class="eyebrow mb-5">Services</p>
      <h1 class="text-6xl md:text-7xl leading-none mb-6">San Diego's <span class="italic text-pine">preferred</span> videography team</h1>
      <p class="text-lg leading-relaxed text-muted">
        Since 2019 we've worked with San Diego couples and businesses of all sizes on wedding films, promotional videos, event coverage, and custom projects, tailored to your brand, audience, and budget.
      </p>
    </header>
  </Container>

  <section class="border-t border-line">
    <Container>
      <div class="max-w-5xl mx-auto">
        {
          services.map((service) => (
            <article id={service.id} class="grid md:grid-cols-[1fr_2fr] gap-8 md:gap-16 py-20 border-b border-line scroll-mt-8">
              <div>
                <span class="font-serif italic text-2xl text-pine">{service.numeral}</span>
                <h2 class="text-5xl leading-none mt-3">{service.title}</h2>
                {service.includes && (
                  <ul class="mt-8 flex flex-col gap-2 text-sm font-semibold uppercase tracking-[0.14em] text-muted">
                    {service.includes.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
              <div>
                <p class="font-serif text-3xl leading-snug mb-6">{service.lead}</p>
                {service.details.map((p) => (
                  <p class="text-lg leading-relaxed text-muted mb-5">{p}</p>
                ))}
                <a href="/contact" class="btn-primary mt-3">{service.cta}</a>
                {service.category && related[service.category]?.length ? (
                  <div class="mt-10 pt-6 border-t border-line">
                    <p class="eyebrow mb-3">From the blog</p>
                    <ul class="flex flex-col gap-2">
                      {related[service.category]!.map((post) => (
                        <li>
                          <a href={`/blog/${post.slug}`} class="font-serif text-2xl hover:text-pine">{post.title} →</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : null}
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="bg-sand">
    <Container>
      <div class="py-28 max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <p class="eyebrow mb-4">Our process</p>
          <h2 class="text-5xl md:text-6xl leading-none">From first call to <span class="italic">final cut</span></h2>
        </div>
        <ol class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
          {
            processSteps.map((step, i) => (
              <li class="flex flex-col gap-3">
                <span class="eyebrow">Step {i + 1}</span>
                <h3 class="text-3xl leading-none">{step.title}</h3>
                <p class="text-muted leading-relaxed">{step.detail}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </section>

  <Container>
    <section class="py-28 max-w-3xl mx-auto text-center">
      <p class="eyebrow mb-4">Pricing</p>
      <h2 class="text-5xl md:text-6xl leading-none mb-8">Priced for your <span class="italic">project</span></h2>
      <p class="text-lg leading-relaxed text-muted mb-5">
        Our prices are based on the scope of your project, time spent editing, and an hourly rate for filming and coverage. Most business video projects start at $500 and range from $1,000 to $3,500.
      </p>
      <p class="text-lg leading-relaxed text-muted mb-10">
        We'll schedule a phone call to hammer out the details and get you a transparent quote before any work begins.
      </p>
      <a href="/contact" class="btn-primary">Get a quote now</a>
    </section>
  </Container>
</Layout>
